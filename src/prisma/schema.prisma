generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model breedingsows {
  sow_id            Int            @id @default(autoincrement())
  breed_id          Int
  sow_tag_number    String         @unique @db.VarChar(50)
  entry_date        DateTime       @db.Date
  weight            Decimal?       @db.Decimal(5, 2)
  length            Decimal?       @db.Decimal(5, 2)
  mammary_glands    Int?
  farrowing_number  Int?           @default(0)
  last_weaning_date DateTime?      @db.Date
  removal_date      DateTime?      @db.Date
  removal_reason    String?
  description       String?
  status            String         @db.VarChar(50)
  breeds            breeds         @relation(fields: [breed_id], references: [breed_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_breed")
  farrowings        farrowings[]
  matingevents      matingevents[]
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model boars {
  boar_id         Int            @id @default(autoincrement())
  breed_id        Int
  boar_tag_number String         @unique @db.VarChar(50)
  weight          Decimal?       @db.Decimal(5, 2)
  length          Decimal?       @db.Decimal(5, 2)
  birth_date      DateTime       @db.Date
  removal_date    DateTime?      @db.Date
  removal_reason  String?
  description     String?
  breeds          breeds         @relation(fields: [breed_id], references: [breed_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_breed")
  matingevents    matingevents[]
}

model matingevents {
  mating_id         Int          @id @default(autoincrement())
  sow_id            Int
  boar_id           Int?
  reproduction_date DateTime     @db.Date
  reproduction_type String?      @db.VarChar(50)
  pregnancy_result  String       @db.VarChar(50)
  notes             String?
  farrowings        farrowings[]
  boars             boars?       @relation(fields: [boar_id], references: [boar_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_boar")
  breedingsows      breedingsows @relation(fields: [sow_id], references: [sow_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_sow")
}

model farrowings {
  farrowing_id   Int          @id @default(autoincrement())
  sow_id         Int
  mating_id      Int
  farrowing_date DateTime     @db.Timestamp(6)
  male_piglets   Int?         @default(0)
  female_piglets Int?         @default(0)
  live_births    Int?         @default(dbgenerated("(male_piglets + female_piglets)"))
  still_births   Int?         @default(0)
  mummies        Int?         @default(0)
  weaning_date   DateTime?    @default(dbgenerated("(farrowing_date + '30 days'::interval)")) @db.Timestamp(6)
  weaned_piglets Int?         @default(0)
  notes          String?
  weaned_date    DateTime?    @db.Timestamp(6)
  matingevents   matingevents @relation(fields: [mating_id], references: [mating_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_mating_event")
  breedingsows   breedingsows @relation(fields: [sow_id], references: [sow_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_sow")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model breeds {
  breed_id     Int            @id @default(autoincrement())
  breed_name   String         @unique @db.VarChar(50)
  description  String?
  boars        boars[]
  breedingsows breedingsows[]
}
