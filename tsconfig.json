{
  "compilerOptions": {
    // Production compilation: source files become JavaScript under dist/.
    "rootDir": "./src",
    "outDir": "./dist",

    // Match the Node.js module system used by the application runtime.
    "target": "es2020",
    "module": "node16",
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "lib": ["esnext"],

    // Keep source maps for debugging while excluding source comments from production output.
    "sourceMap": true,
    "removeComments": true,

    // Enforce the project's chosen baseline for application code.
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noImplicitReturns": true
  },
  "editor.defaultFormatter": "biomejs.biome",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.organizeImports": true
  },
  // Tests have a dedicated configuration so they do not change production build output paths.
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
