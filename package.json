{
  "name": "porcigestion",
  "version": "1.0.0",
  "description": "",
  "main": "app.js",
  "scripts": {
    "build": "tsc -p .",
    "dev": "nodemon src/app.ts",
    "start": "node dist/app.js",
    "db:pull": "npx prisma db pull --schema=src/prisma/schema.prisma",
    "generate": "npx prisma generate --schema=src/prisma/schema.prisma",
    "db:sync": "npm run db:pull && npm run generate",
    "migrate": "npx prisma migrate dev --schema=src/prisma/schema.prisma",
    "db:reset": "npx prisma migrate reset --force --skip-seed --schema=src/prisma/schema.prisma",
    "format": "npx biome check --write ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.18.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/helmet": "^0.0.48",
    "@types/node": "^20.19.17",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "nodemon": "^3.1.10",
    "prisma": "^6.16.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
